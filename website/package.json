{
  "name": "uele-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "uele documentation site with live code playground",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "postinstall": "node scripts/bundle.mjs",
    "dev": "node scripts/bundle.mjs && vite --host 0.0.0.0",
    "build": "node scripts/bundle.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check-examples": "node scripts/check-examples.mjs",
    "check-pipeline": "node scripts/check-playground-pipeline.mjs",
    "check-signals": "node scripts/check-signals.mjs",
    "smoke": "node scripts/smoke-site.mjs",
    "test": "node scripts/check-examples.mjs && node scripts/check-playground-pipeline.mjs && node scripts/check-signals.mjs && node scripts/smoke-site.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "^7.26.4",
    "@preact/signals-core": "^1.14.4",
    "esbuild": "^0.24.2",
    "linkedom": "^0.18.9",
    "udomdiff": "^1.1.2",
    "ulive": "^1.0.7",
    "usub": "^0.9.0",
    "vite": "^6.0.7"
  }
}
