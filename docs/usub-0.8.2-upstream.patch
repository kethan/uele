From f63caafd7667d896cb609d2bc5a1e2fe30451e8f Mon Sep 17 00:00:00 2001
From: Kethan Surana <ckethan1@gmail.com>
Date: Thu, 15 Oct 2026 04:33:28 +0000
Subject: [PATCH] fix: never park effect-owned subscriptions in the
 FinalizationRegistry

A registry entry can never be cleared when the value registered for the target
can reach the target - the finalizer keeps the target alive. An effect runner
owns its disposer (which closes over the runner and its callback), so parking
that disposer retained the source and everything the callback touched, forever,
even after the subscription was disposed.

Keep the disposer the effect runner returned and only fall back to the registry
when no effect owns the subscription. The safety net is preserved for every path
we do not own (subscribe/then/async-iterator): a collected source still runs the
unsubscriber. Applies to src, lite and tiny; the new tests pin both halves on all
three builds (0 of 40 refs retained vs 40 of 40 before the fix).
---
 lite/index.js     |  6 ++---
 package-lock.json |  4 ++--
 package.json      |  2 +-
 src/index.js      |  6 ++---
 test/index.js     | 60 +++++++++++++++++++++++++++++++++++++++++++++++
 tiny/index.js     |  6 ++---
 6 files changed, 72 insertions(+), 12 deletions(-)

diff --git a/lite/index.js b/lite/index.js
index e8f3988..bee5137 100644
--- a/lite/index.js
+++ b/lite/index.js
@@ -13,11 +13,11 @@ const is = arg => arg && !!(
     api.is(arg) ||                   // Custom observable check
     arg.call                         // Function
 );
-const sub = (target, next, error, cleanup, stop, unsub) => target &&
+const sub = (target, next, error, cleanup, stop, unsub, fx) => target &&
     (
         unsub =
         ((api.is(target) || target.call) && (
-            api.any?.(target)?.(next, error, cleanup) || api.effect?.(() => (next(get(target)), api.cleanup?.(cleanup), cleanup))
+            api.any?.(target)?.(next, error, cleanup) || (fx = api.effect?.(() => (next(get(target)), api.cleanup?.(cleanup), cleanup)))
         )) ||
         (
             target.then?.(v => (!stop && next(get(v)), cleanup?.()), error) ||
@@ -28,7 +28,7 @@ const sub = (target, next, error, cleanup, stop, unsub) => target &&
                 } catch (err) { error?.(err) }
             })()
         ) && (_ => stop = 1),
-        registry.register(target, unsub),
+        fx || registry.register(target, unsub),
         unsub
     );
 
